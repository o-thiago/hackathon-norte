{
  "name": "@sentinela/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../.env --hot src/index.ts",
    "start": "bun --env-file=../.env src/index.ts",
    "db:push": "bun --env-file=../.env --bun drizzle-kit push --force",
    "db:generate": "drizzle-kit generate",
    "db:seed": "bun --env-file=../.env src/db/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
